# Heavy derived datasets, reproducible from the scripts.
paper_1_transfer/data_derived/

# Fitted brms/Stan objects are large and are regenerated by the model scripts.
paper_1_transfer/results/*.rds

# Stan/cmdstanr scratch and compiled model artefacts.
*.stan
!**/stan/*.stan
*_cmdstan_*

# Quarto and LaTeX render artefacts. The manuscript PDF is deliberately NOT ignored:
# it is the published output of this repository.
/paper_1_transfer/*_files/
/paper_1_transfer/*.tex
/paper_1_transfer/*.html
/paper_1_transfer/*.rmarkdown
/paper_1_transfer/*.log
/paper_1_transfer/*.aux
/paper_1_transfer/*.out
.quarto/

# Cluster job logs.
/paper_1_transfer/hpc/logs/

# R session cruft.
.Rhistory
.Rdata
.Rproj.user/

# Credential-bearing R startup files. SCOPUS_API_KEY is read from ~/.Renviron, and a
# project-local .Renviron would carry it into the repository.
.Renviron
.Rprofile.local

